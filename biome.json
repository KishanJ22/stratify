{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!apps/api/stratify-api/src/database/types.ts",
			"!apps/ui/stratify-ui/next-env.d.ts",
			"!apps/api/stratify-data-api/docs/openapi.json",
			"!apps/api/stratify-api/docs/**/bruno.json",
			"!apps/api/stratify-data-api/docs/**/bruno.json"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 4
	},
	"linter": {
		"enabled": true,
		"includes": ["**", "!apps/api/stratify-api/src/database/migrations/**"],
		"rules": {
			"preset": "recommended",
			"correctness": {
				"noUnusedImports": "on"
			},
			"style": {
				"useImportType": "on",
				"useExportType": "on"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/*.test.ts", "**/*.test.tsx"],
			"linter": {
				"rules": {
					"suspicious": {
						"noExplicitAny": "off"
					},
					"performance": {
						"noImgElement": "off"
					}
				}
			}
		},
		{
			"includes": ["apps/api/stratify-api/src/config.ts"],
			"linter": {
				"rules": {
					"style": {
						"noNonNullAssertion": "off"
					}
				}
			}
		}
	]
}
